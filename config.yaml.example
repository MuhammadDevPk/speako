# speako — configuration
# Copy to config.yaml (project) or ~/.config/speako/config.yaml (user).
# Environment variables and CLI flags override values set here.
# Secrets (API keys) are NEVER read from this file; they live in .env only.

providers:
  # Ordered dispatch chain: Groq (ultra-fast Whisper-large-v3) -> Gemini Flash fallback.
  # Local models (Intel / M1) are disabled in favor of high-accuracy API transcription.
  priority: [groq, gemini]

  groq:
    model: whisper-large-v3
    api_keys_env: GROQ_API_KEYS
    prompt: "Accurate verbatim speech transcription with proper spelling, capitalization, and punctuation."
    language: null  # null -> auto-detect language, or specify "en"

  gemini:
    model: gemini-2.5-flash
    api_keys_env: GEMINI_API_KEYS
    prompt: "Transcribe the spoken audio in this clip exactly. Do not add any greeting, answers, explanations, or comments. Return only the verbatim transcription text without quotes or markdown formatting."

audio:
  sample_rate: 16000   # Whisper family expects 16 kHz mono
  channels: 1
  device: null         # null → system default input
  max_seconds: 120     # hard cap per capture

hotkey:
  # Any of:
  #   pynput Key names: alt, alt_l, alt_r, cmd, cmd_l, cmd_r, ctrl, ctrl_l,
  #     ctrl_r, shift, shift_l, shift_r, f1..f24, caps_lock, esc, tab, ...
  #   Friendly aliases: right_option, left_option, right_cmd, left_cmd,
  #     right_ctrl, left_ctrl, option, command, control, ...
  #   Single characters: "a", "'"
  key: right_option
  mode: hold           # "hold" (press-and-hold) or "toggle" (tap on / tap off)

output:
  method: paste            # "paste" (clipboard + Cmd/Ctrl+V) or "type" (character-by-character)
  restore_clipboard: true  # only relevant for method=paste

cooldown:
  initial_seconds: 30
  factor: 4
  max_seconds: 600

logging:
  level: INFO
  format: json           # "json" or "text"

ui:
  enabled: true          # false → headless (no floating overlay); runtime stays on main thread
  position: bottom_center  # "bottom_center" or "top_center"
  margin_px: 80          # distance from the chosen screen edge
  opacity: 0.92          # whole-window alpha, 0.0–1.0
