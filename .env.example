# speako — environment variables
# Copy to .env and fill in real values. .env is git-ignored.
#
# API keys are comma-separated to support pool rotation. Whitespace around
# commas is tolerated. Empty entries are ignored.

# Groq (Whisper models)
GROQ_API_KEYS=gsk_key_1,gsk_key_2

# Gemini (Flash audio transcription)
GEMINI_API_KEYS=AIza_key_1,AIza_key_2

# Optional: override the default config file path
# SPEAKO_CONFIG=/absolute/path/to/config.yaml

# Optional: override log level (DEBUG | INFO | WARNING | ERROR)
# SPEAKO_LOG_LEVEL=INFO
